{
  "name": "dsh-image-question",
  "version": "0.0.1",
  "private": true,
  "description": "DSH Web image-annotation question plugin: agent asks with an image, the browser annotates, the agent receives structured source-pixel results.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
